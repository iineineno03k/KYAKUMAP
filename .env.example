# OrcaRouter（OpenRouterではない）。サーバー側でのみ使用する。
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
# 無料枠はモデル一覧から都度確認する。2026-09-21時点の現行free alias。
ORCAROUTER_KNOWLEDGE_MODEL=deepseek/deepseek-v4-flash-free
ORCAROUTER_CUSTOMER_CHAT_MODEL=deepseek/deepseek-v4-flash-free
# 無料TTSモデルはないため、既定はブラウザ標準の音声合成へフォールバックする。
ORCAROUTER_TTS_MODEL=browser

# Notionは最初の入力コネクタ。顧客マップUIから直接操作しない。
NOTION_API_TOKEN=
NOTION_DATA_SOURCE_ID=

# 原本・知識グラフ・情報領域状態のSSoT。
DATABASE_URL=postgresql://app:app@localhost:54329/sales_preparation
