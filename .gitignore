# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# probe が作る一時音声
scripts/.probe-speech.*

# 実測ログ（実際に使ったセッションの記録）
.logs/
